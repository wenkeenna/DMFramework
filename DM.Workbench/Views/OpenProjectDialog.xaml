<UserControl
    x:Class="DM.Workbench.Views.OpenProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DM.UI;component/Themes/Themes.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Width" Value="420" />
            <Setter Property="Height" Value="400" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>
    </prism:Dialog.WindowStyle>
    <DockPanel Margin="12">
        <StackPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
            <TextBlock Foreground="#B23A48" Text="{Binding Message}" />
            <StackPanel
                Margin="0,6,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="0,0,8,0"
                    Style="{DynamicResource LabViewButton}"
                    Command="{Binding ConfirmCommand}"
                    Content="打开"
                    IsDefault="True" />
                <Button
                    Width="80"
                    Style="{DynamicResource LabViewButton}"
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    IsCancel="True" />
            </StackPanel>
        </StackPanel>
        <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding Selected}">
            <ListBox.InputBindings>
                <MouseBinding Command="{Binding ConfirmCommand}" Gesture="LeftDoubleClick" />
            </ListBox.InputBindings>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Right"
                            Opacity="0.6"
                            Text="{Binding CreatedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
