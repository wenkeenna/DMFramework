<UserControl x:Class="DM.Workbench.Views.TaskTypePickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Width" Value="360" />
            <Setter Property="Height" Value="460" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>
    </prism:Dialog.WindowStyle>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="80" Margin="0,0,8,0" Content="添加" IsDefault="True" Command="{Binding PickCommand}" />
            <Button Width="80" Content="取消" IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Types}" SelectedItem="{Binding Selected}" DisplayMemberPath="DisplayName">
            <ListBox.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding PickCommand}" />
            </ListBox.InputBindings>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,6,0,2" FontWeight="Bold" Foreground="#1565C0" Text="{Binding Name}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
        </ListBox>
    </DockPanel>
</UserControl>
