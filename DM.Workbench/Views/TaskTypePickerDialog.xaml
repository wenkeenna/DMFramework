<UserControl
    x:Class="DM.Workbench.Views.TaskTypePickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DM.UI;component/Themes/Themes.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Width" Value="360" />
            <Setter Property="Height" Value="460" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>
    </prism:Dialog.WindowStyle>
    <DockPanel Margin="12">
        <StackPanel
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Style="{DynamicResource LabViewButton}"
                Command="{Binding PickCommand}"
                Content="添加"
                IsDefault="True" />
            <Button
                Width="80"
                Command="{Binding CancelCommand}"
                Style="{DynamicResource LabViewButton}"
                Content="取消"
                IsCancel="True" />
        </StackPanel>
        <ListBox
            DisplayMemberPath="DisplayName"
            ItemsSource="{Binding Types}"
            SelectedItem="{Binding Selected}">
            <ListBox.InputBindings>
                <MouseBinding Command="{Binding PickCommand}" Gesture="LeftDoubleClick" />
            </ListBox.InputBindings>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="0,6,0,2"
                                FontWeight="Bold"
                                Foreground="#1565C0"
                                Text="{Binding Name}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
        </ListBox>
    </DockPanel>
</UserControl>
