<UserControl x:Class="DM.Workbench.Views.TaskEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/" Width="1000" Height="600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </UserControl.Resources>
    <prism:Dialog.WindowStyle>
        <!--<Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1200" />
            <Setter Property="Height" Value="760" />
            <Setter Property="MinWidth" Value="900" />
            <Setter Property="MinHeight" Value="520" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>-->
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" />
                </Setter.Value>
            </Setter>
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1200" />
            <Setter Property="Height" Value="760" />
            <Setter Property="MinWidth" Value="900" />
            <Setter Property="MinHeight" Value="520" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Topmost" Value="True" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 统一的通用配置：所有任务类型共用 -->
        <GroupBox Grid.Row="0" Grid.Column="0" Header="通用配置">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6">
                    <TextBlock Text="任务类型:" />
                    <TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Foreground="Green" TextWrapping="Wrap" Text="{Binding TypeName}" />

                    <TextBlock Margin="0,10,0,0" Text="任务说明:" />
                    <TextBox Height="96" Margin="0,2,0,0" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Text="{Binding TypeDescription, Mode=OneWay}" />

                    <StackPanel IsEnabled="{Binding CanApply}">
                        <TextBlock Margin="0,10,0,0" Text="任务名称:" />
                        <TextBox Height="30" Margin="0,2,0,0" VerticalContentAlignment="Center" MaxLength="64"
                                 Text="{Binding Common.Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="列表内唯一，用于识别任务" />

                        <CheckBox Margin="0,14,0,0" Content="启用" IsChecked="{Binding Common.Enabled}" ToolTip="取消勾选后，运行时跳过这个任务" />
                        <CheckBox Margin="0,8,0,0" Content="执行后暂停" IsChecked="{Binding Common.PauseAfter}" ToolTip="这个任务执行完就停下，点“下一步”继续" />

                        <TextBlock Margin="0,12,0,0" Text="超时(ms，0=不限):" />
                        <TextBox Height="26" Margin="0,2,0,0" VerticalContentAlignment="Center"
                                 Text="{Binding Common.TimeoutMs, UpdateSourceTrigger=PropertyChanged}" ToolTip="超过时间任务按失败处理，并停止其运动" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- 具体任务的参数界面 -->
        <ContentControl Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" Content="{Binding Editor}" Width="Auto" Height="Auto"/>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="90" Margin="0,0,8,0" Content="确定" Command="{Binding OkCommand}"
                        Visibility="{Binding CanApply, Converter={StaticResource B2V}}" />
                <Button Width="90" Content="{Binding CancelText}" IsCancel="True" Command="{Binding CancelCommand}" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="#B23A48" TextWrapping="Wrap" Text="{Binding Message}" />
        </DockPanel>
    </Grid>
</UserControl>
