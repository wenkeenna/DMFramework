<UserControl
    x:Class="DM.Parameters.Views.ParameterEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="clr-namespace:DM.Parameters.Models"
    xmlns:prism="http://prismlibrary.com/">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DM.UI;component/Themes/Themes.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="B2V" />

            <!--  叶子：参数名 | 值（行内可编辑；布尔值显示复选框）| 类型  -->
            <HierarchicalDataTemplate DataType="{x:Type m:ParamGroupNode}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        Opacity="0.55"
                        Text="{Binding CountText}" />
                </StackPanel>
            </HierarchicalDataTemplate>

            <DataTemplate DataType="{x:Type m:ParamLeafNode}">
                <Grid MinWidth="420">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Key}" />

                    <Grid Grid.Column="1" Margin="8,0">
                        <!--  普通值：显示文本，双击进入编辑  -->
                        <TextBlock
                            x:Name="ValueText"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            Foreground="#2E7D32"
                            MouseLeftButtonDown="ValueText_MouseLeftButtonDown"
                            Text="{Binding Display}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBool}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--  编辑中：文本框，回车确认、Esc 取消、失焦确认（失败则取消提交，仍保持编辑）  -->
                        <TextBox
                            x:Name="Editor"
                            FontFamily="Consolas"
                            IsVisibleChanged="Editor_IsVisibleChanged"
                            KeyDown="Editor_KeyDown"
                            LostKeyboardFocus="Editor_LostKeyboardFocus"
                            Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!--  布尔值：直接勾选  -->
                        <CheckBox
                            VerticalAlignment="Center"
                            Click="BoolCheck_Click"
                            IsChecked="{Binding BoolValue, Mode=OneWay}">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBool}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </Grid>

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Opacity="0.55"
                        Text="{Binding Kind}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <prism:Dialog.WindowStyle>
        <!--<Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="Width" Value="500" />
            <Setter Property="Height" Value="680" />

            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>-->
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" />
                </Setter.Value>
            </Setter>
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="500" />
            <Setter Property="Height" Value="760" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Topmost" Value="True" />
        </Style>


    </prism:Dialog.WindowStyle>

    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />

            <RowDefinition Height="Auto" />
            <!--  主行：范围 + 展开/收起 + 开关  -->
            <RowDefinition Height="Auto" />
            <!--  高级区域（可折叠）  -->
            <RowDefinition Height="*" />
            <!--  TreeView 始终可见  -->
            <RowDefinition Height="Auto" />
            <!--  底部状态行  -->
        </Grid.RowDefinitions>


        <Grid Grid.Row="0" Background="Transparent">
            <DockPanel>
                <TextBlock VerticalAlignment="Center" Text="参数编辑" />
            </DockPanel>
        </Grid>


        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Text="范围 " />
            <ComboBox
                Width="150"
                Margin="0,0,12,0"
                DisplayMemberPath="Name"
                DockPanel.Dock="Left"
                ItemsSource="{Binding Scopes}"
                SelectedItem="{Binding SelectedScope}" />

            <Button
                Width="25"
                Height="25"
                Margin="0,0,6,0"
                Padding="0"
                Command="{Binding ExpandAllCommand}"
                Content="&#xe829;"
                FontFamily="{DynamicResource Iconfont}"
                FontSize="12"
                Style="{DynamicResource LabViewButton}"
                ToolTip="展开全部" />
            <Button
                Width="25"
                Height="25"
                Margin="0,0,6,0"
                Padding="0"
                Command="{Binding CollapseAllCommand}"
                Content="&#xe828;"
                FontFamily="{DynamicResource Iconfont}"
                FontSize="12"
                Style="{DynamicResource LabViewButton}"
                ToolTip="收起全部" />

            <!--  开关：控制高级区显隐  -->
            <!--<ToggleButton
                x:Name="AdvancedToggle"
                Margin="12,0,0,0"
                Padding="10,2"
                Content="更多 ▾"
                DockPanel.Dock="Left"
                IsChecked="{Binding ShowAdvanced, Mode=TwoWay}" Cursor="" />-->
            <CheckBox
                x:Name="AdvancedToggle"
                VerticalAlignment="Center"
                Content="编辑"
                IsChecked="{Binding ShowAdvanced, Mode=TwoWay}" />

        </DockPanel>


        <!--<WrapPanel Grid.Row="1" Margin="0,0,0,6" />-->

        <StackPanel Grid.Row="2" Visibility="{Binding ShowAdvanced, Converter={StaticResource B2V}}">

            <!--  原来 Row 3 的编辑区 GroupBox  -->
            <GroupBox
                Margin="0,6,0,0"
                Header="新增参数（选中组时自动填入组名；组名不存在则新建）"
                Visibility="{Binding CanEdit, Converter={StaticResource B2V}}">
                <StackPanel>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            VerticalContentAlignment="Center"
                            Text="{Binding NewGroup, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="组（Root），如 Pos" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Text="." />
                        <TextBox
                            Grid.Column="2"
                            VerticalContentAlignment="Center"
                            Text="{Binding NewChild, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="参数名（Child），如 PickZ。脚本里写成 @Pos.PickZ" />
                        <ComboBox
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            ItemsSource="{Binding Kinds}"
                            SelectedItem="{Binding NewKind}" />
                        <TextBox
                            Grid.Column="4"
                            Margin="8,0,0,0"
                            VerticalContentAlignment="Center"
                            Cursor=""
                            Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="初始值" />
                        <Button
                            Grid.Column="5"
                            Width="50"
                            Margin="8,0,0,0"
                            Padding="16,2"
                            Command="{Binding AddCommand}"
                            Content="添加"
                            Style="{DynamicResource LabViewButton}" />
                    </Grid>

                    <DockPanel
                        Grid.Row="4"
                        Margin="0,6,0,0"
                        LastChildFill="False">

                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Cursor=""
                            DockPanel.Dock="Left"
                            Opacity="0.6"
                            Text="{Binding SelectedText, StringFormat=当前：{0}}" />


                        <Button
                            Margin="0,0,5,0"
                            Padding="12,2"
                            Command="{Binding DeleteCommand}"
                            Content="删除所选"
                            DockPanel.Dock="Right"
                            Style="{DynamicResource LabViewButton}" />

                        <Button
                            Margin="5,0,5,0"
                            Padding="12,2"
                            Command="{Binding RenameCommand}"
                            Content="重命名…"
                            DockPanel.Dock="Right"
                            Style="{DynamicResource LabViewButton}"
                            ToolTip="选中参数改参数名，选中组改整组名" />


                        <Button
                            Width="80"
                            Margin="0,0,6,0"
                            Padding="6,2"
                            Command="{Binding RefreshCommand}"
                            Content="刷新"
                            DockPanel.Dock="Right"
                            FontFamily="{DynamicResource Iconfont}"
                            Style="{DynamicResource LabViewButton}"
                            Tag="&#xe831;"
                            ToolTip="刷新" />



                    </DockPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>


        <TreeView
            x:Name="Tree"
            Grid.Row="3"
            MinHeight="100"
            ItemsSource="{Binding Groups}"
            PreviewKeyDown="Tree_PreviewKeyDown"
            SelectedItemChanged="Tree_SelectedItemChanged"
            VirtualizingPanel.IsVirtualizing="True">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                        <!--<Trigger Property="IsSelected" Value="True">
                            <Setter Property="Opacity" Value="0.1" />

                        </Trigger>-->
                    </Style.Triggers>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>



        <DockPanel Grid.Row="4" Margin="0,6,0,0">
            <Button
                Width="80"
                Command="{Binding CloseCommand}"
                Content="关闭"
                DockPanel.Dock="Right"
                IsCancel="True"
                Style="{DynamicResource LabViewButton}" />
            <TextBlock
                Margin="12,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Opacity="0.6"
                Text="{Binding CountText}" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{Binding Status}"
                TextWrapping="Wrap" />
        </DockPanel>

    </Grid>
</UserControl>
