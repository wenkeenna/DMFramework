<UserControl x:Class="DM.Parameters.Views.ParameterEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:m="clr-namespace:DM.Parameters.Models">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />

        <!-- 叶子：参数名 | 值（行内可编辑；布尔值显示复选框）| 类型 -->
        <HierarchicalDataTemplate DataType="{x:Type m:ParamGroupNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                <TextBlock Margin="6,0,0,0" Opacity="0.55" Text="{Binding CountText}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type m:ParamLeafNode}">
            <Grid MinWidth="420">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip="{Binding Key}" />

                <Grid Grid.Column="1" Margin="8,0">
                    <!-- 普通值：显示文本，双击进入编辑 -->
                    <TextBlock x:Name="ValueText" VerticalAlignment="Center" FontFamily="Consolas" Foreground="#2E7D32"
                               Text="{Binding Display}" MouseLeftButtonDown="ValueText_MouseLeftButtonDown">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBool}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 编辑中：文本框，回车确认、Esc 取消、失焦确认（失败则取消提交，仍保持编辑） -->
                    <TextBox x:Name="Editor" FontFamily="Consolas" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="Editor_KeyDown" LostKeyboardFocus="Editor_LostKeyboardFocus" IsVisibleChanged="Editor_IsVisibleChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- 布尔值：直接勾选 -->
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding BoolValue, Mode=OneWay}" Click="BoolCheck_Click">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBool}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </Grid>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.55" Text="{Binding Kind}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterOwner" />
            <Setter Property="Width" Value="760" />
            <Setter Property="Height" Value="680" />
            <Setter Property="MinWidth" Value="560" />
            <Setter Property="MinHeight" Value="460" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="范围 " />
            <ComboBox DockPanel.Dock="Left" Width="190" Margin="0,0,12,0" ItemsSource="{Binding Scopes}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedScope}" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="搜索 " />
            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="按键或值过滤，命中项所在的组自动展开" />
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <Button Margin="0,0,6,0" Padding="12,2" Content="全部展开" Command="{Binding ExpandAllCommand}" />
            <Button Margin="0,0,6,0" Padding="12,2" Content="全部折叠" Command="{Binding CollapseAllCommand}" />
            <Button Margin="0,0,6,0" Padding="12,2" Content="刷新" Command="{Binding RefreshCommand}" />
            <Button Margin="18,0,6,0" Padding="12,2" Content="重命名…" Command="{Binding RenameCommand}" ToolTip="选中参数改参数名，选中组改整组名" />
            <Button Margin="0,0,6,0" Padding="12,2" Content="删除所选" Command="{Binding DeleteCommand}" />
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.6" Text="{Binding SelectedText, StringFormat=当前：{0}}" />
        </WrapPanel>

        <TreeView x:Name="Tree" Grid.Row="2" ItemsSource="{Binding Groups}" SelectedItemChanged="Tree_SelectedItemChanged"
                  VirtualizingPanel.IsVirtualizing="True" PreviewKeyDown="Tree_PreviewKeyDown">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>

        <GroupBox Grid.Row="3" Margin="0,6,0,0" Header="新增参数（选中组时自动填入组名；组名不存在则新建）"
                  Visibility="{Binding CanEdit, Converter={StaticResource B2V}}">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding NewGroup, UpdateSourceTrigger=PropertyChanged}" ToolTip="组（Root），如 Pos" />
                <TextBlock Grid.Column="1" Margin="4,0" VerticalAlignment="Center" Text="." />
                <TextBox Grid.Column="2" Text="{Binding NewChild, UpdateSourceTrigger=PropertyChanged}" ToolTip="参数名（Child），如 PickZ。脚本里写成 @Pos.PickZ" />
                <ComboBox Grid.Column="3" Margin="8,0,0,0" ItemsSource="{Binding Kinds}" SelectedItem="{Binding NewKind}" />
                <TextBox Grid.Column="4" Margin="8,0,0,0" Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="初始值" />
                <Button Grid.Column="5" Margin="8,0,0,0" Padding="16,2" Content="添加" Command="{Binding AddCommand}" />
            </Grid>
        </GroupBox>

        <DockPanel Grid.Row="4" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Width="80" Content="关闭" IsCancel="True" Command="{Binding CloseCommand}" />
            <TextBlock DockPanel.Dock="Right" Margin="12,0" VerticalAlignment="Center" Opacity="0.6" Text="{Binding CountText}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Status}" />
        </DockPanel>
    </Grid>
</UserControl>
