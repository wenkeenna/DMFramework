<UserControl
    x:Class="DM.Motion.Manual.Views.ManualMotionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Lamp" TargetType="Ellipse">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stroke" Value="#666" />
            <Setter Property="Fill" Value="#DDD" />
        </Style>
        <Style x:Key="JogButton" TargetType="Button">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Focusable" Value="False" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Jog_Down" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Jog_Up" />
            <!--<EventSetter Event="MouseLeave" Handler="Jog_Up" />-->
        </Style>
    </UserControl.Resources>

    <TabControl Margin="4">
        <TabItem Header="手动运动">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Margin="0,0,0,6">
                    <TextBlock VerticalAlignment="Center" Text="速度 " />
                    <TextBox Width="60" Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Margin="4,0,0,0"
                        Padding="6,0"
                        Command="{Binding SetSpeedCommand}"
                        CommandParameter="0.1"
                        Content="0.1" />
                    <Button
                        Margin="2,0,0,0"
                        Padding="6,0"
                        Command="{Binding SetSpeedCommand}"
                        CommandParameter="1"
                        Content="1" />
                    <Button
                        Margin="2,0,0,0"
                        Padding="6,0"
                        Command="{Binding SetSpeedCommand}"
                        CommandParameter="5"
                        Content="5" />
                    <Button
                        Margin="2,0,12,0"
                        Padding="6,0"
                        Command="{Binding SetSpeedCommand}"
                        CommandParameter="20"
                        Content="20" />
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="连续点动（或按住 Ctrl）"
                        IsChecked="{Binding Continuous}" />
                    <Button
                        Margin="16,0,0,0"
                        Padding="14,2"
                        Background="#F7D7D7"
                        Command="{Binding StopAllCommand}"
                        Content="停止所有轴" />
                </WrapPanel>

                <TabControl
                    Grid.Row="1"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Groups}"
                    SelectedItem="{Binding ActiveGroup}">
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <CheckBox
                                    Margin="4"
                                    Content="同步模式（左右轴一起点动）"
                                    DockPanel.Dock="Top"
                                    IsChecked="{Binding SyncEnabled}">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSync}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>

                                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Pads}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <GroupBox Margin="4" Header="{Binding Title}">
                                                <ItemsControl ItemsSource="{Binding Slots}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                            </Grid>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Grid.Row" Value="{Binding Row}" />
                                                            <Setter Property="Grid.Column" Value="{Binding Col}" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                Content="{Binding Label}"
                                                                Style="{StaticResource JogButton}"
                                                                ToolTip="{Binding Axis}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </GroupBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DataGrid
                                    Margin="4"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    ItemsSource="{Binding Axes}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="90"
                                            Binding="{Binding Name}"
                                            Header="轴"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            Width="90"
                                            Binding="{Binding Position, StringFormat=F3}"
                                            Header="位置"
                                            IsReadOnly="True" />
                                        <DataGridTemplateColumn Width="90" Header="步距">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox
                                                        IsEditable="True"
                                                        ItemsSource="{Binding StepOptions}"
                                                        Text="{Binding Step, UpdateSourceTrigger=LostFocus}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="46" Header="运动">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Ellipse HorizontalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style BasedOn="{StaticResource Lamp}" TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Moving}" Value="True">
                                                                        <Setter Property="Fill" Value="#4DA3FF" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="46" Header="报警">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Ellipse HorizontalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style BasedOn="{StaticResource Lamp}" TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Alarm}" Value="True">
                                                                        <Setter Property="Fill" Value="#D74C3C" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="56" Header="已回零">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Ellipse HorizontalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style BasedOn="{StaticResource Lamp}" TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Homed}" Value="True">
                                                                        <Setter Property="Fill" Value="#25C05A" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="*" Header="操作">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button
                                                            Padding="8,0"
                                                            Command="{Binding DataContext.HomeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="回零" />
                                                        <Button
                                                            Margin="4,0,0,0"
                                                            Padding="8,0"
                                                            Command="{Binding DataContext.ClearAlarmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Content="清报警" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <TextBlock
                    Grid.Row="2"
                    Margin="0,6,0,0"
                    Foreground="#B23A48"
                    Text="{Binding Status}"
                    TextWrapping="Wrap" />
                
            </Grid>
        </TabItem>

        <TabItem Header="IO">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <GroupBox Header="输出（点击切换，需要工程师权限）">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Outputs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="130"
                                        Height="32"
                                        Margin="3"
                                        Command="{Binding DataContext.ToggleOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Name}"
                                        Foreground="White">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#606060" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Value}" Value="True">
                                                        <Setter Property="Background" Value="#2E8B57" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>
                <GroupBox Grid.Row="1" Header="输入">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Inputs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="130"
                                        Margin="3"
                                        Padding="6,4"
                                        BorderBrush="#60A060"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Margin="0,0,6,0" Style="{StaticResource Lamp}">
                                                <Ellipse.Resources />
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
