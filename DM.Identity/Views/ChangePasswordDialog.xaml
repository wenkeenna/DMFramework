<UserControl x:Class="DM.Identity.Views.ChangePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ia="clr-namespace:DM.Identity.Behaviors">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </UserControl.Resources>
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>
    </prism:Dialog.WindowStyle>
    <StackPanel Width="300" Margin="20">
        <TextBlock Visibility="{Binding Forced, Converter={StaticResource B2V}}" Margin="0,0,0,10"
                   Foreground="#B23A48" TextWrapping="Wrap" Text="首次登录或密码被重置，必须先修改密码。" />
        <TextBlock Text="原密码" />
        <PasswordBox Margin="0,4,0,8" ia:PasswordBoxAssist.Attach="True"
                     ia:PasswordBoxAssist.BoundPassword="{Binding OldPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="新密码" />
        <PasswordBox Margin="0,4,0,8" ia:PasswordBoxAssist.Attach="True"
                     ia:PasswordBoxAssist.BoundPassword="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="确认新密码" />
        <PasswordBox Margin="0,4,0,8" ia:PasswordBoxAssist.Attach="True"
                     ia:PasswordBoxAssist.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Foreground="#B23A48" TextWrapping="Wrap" MinHeight="20" Text="{Binding Message}" />
        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="80" Margin="0,0,8,0" Content="确定" IsDefault="True" Command="{Binding OkCommand}" />
            <Button Width="80" Content="取消" IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
