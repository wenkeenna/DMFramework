<UserControl
    x:Class="DM.Identity.Views.AccountManagementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ia="clr-namespace:DM.Identity.Behaviors"
    xmlns:prism="http://prismlibrary.com/">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="Width" Value="820" />
            <Setter Property="Height" Value="460" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>
    </prism:Dialog.WindowStyle>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Accounts}"
            SelectedItem="{Binding Selected, Mode=TwoWay}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Username}"
                    Header="用户名" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Role}"
                    Header="角色" />
                <DataGridCheckBoxColumn
                    Width="50"
                    Binding="{Binding Enabled, Mode=OneWay}"
                    Header="启用" />
                <DataGridCheckBoxColumn
                    Width="50"
                    Binding="{Binding IsLocked, Mode=OneWay}"
                    Header="锁定" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding LastLoginUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                    Header="最近登录" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <GroupBox Header="选中账号">
                <StackPanel Margin="4">
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" />
                    <Button
                        Margin="0,4,0,0"
                        Command="{Binding ApplyRoleCommand}"
                        Content="应用角色" />
                    <Button
                        Margin="0,4,0,0"
                        Command="{Binding ToggleEnabledCommand}"
                        Content="启用 / 停用" />
                    <Button
                        Margin="0,4,0,0"
                        Command="{Binding UnlockCommand}"
                        Content="解锁" />
                    <Button
                        Margin="0,4,0,0"
                        Command="{Binding DeleteCommand}"
                        Content="删除" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Text="重置为新密码（对方下次登录需修改）"
                        TextWrapping="Wrap" />
                    <PasswordBox
                        Margin="0,4,0,0"
                        ia:PasswordBoxAssist.Attach="True"
                        ia:PasswordBoxAssist.BoundPassword="{Binding ResetPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Margin="0,4,0,0"
                        Command="{Binding ResetCommand}"
                        Content="重置密码" />
                </StackPanel>
            </GroupBox>
            <GroupBox Margin="0,8,0,0" Header="新建账号">
                <StackPanel Margin="4">
                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox
                        Margin="0,4,0,0"
                        ia:PasswordBoxAssist.Attach="True"
                        ia:PasswordBoxAssist.BoundPassword="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        Margin="0,4,0,0"
                        ItemsSource="{Binding Roles}"
                        SelectedItem="{Binding NewRole}" />
                    <Button
                        Margin="0,4,0,0"
                        Command="{Binding CreateCommand}"
                        Content="创建" />
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <DockPanel
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,8,0,0">
            <Button
                Width="80"
                Command="{Binding CloseCommand}"
                Content="关闭"
                DockPanel.Dock="Right" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="#B23A48"
                Text="{Binding Message}" />
        </DockPanel>
    </Grid>
</UserControl>
