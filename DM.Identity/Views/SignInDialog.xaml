<UserControl
    x:Class="DM.Identity.Views.SignInDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ia="clr-namespace:DM.Identity.Behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:DM.Identity.ViewModels"
    Width="600"
    Height="300"
    d:DataContext="{d:DesignInstance Type=vm:SignInDialogViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DM.UI;component/Themes/Themes.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" />
                </Setter.Value>
            </Setter>
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ShowInTaskbar" Value="False" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Height" Value="300" />
            <Setter Property="Width" Value="600" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Topmost" Value="True" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Border
        Background="{StaticResource Color.Vs2013BlueThemeColor}"
        BorderBrush="{StaticResource Color.Neutral.Gray.Darker}"
        BorderThickness="0"
        CornerRadius="5">
        <Grid Margin="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Margin="0"
                Background="White"
                CornerRadius="3 0 0 3" Cursor="">
                <!--<StackPanel Width="300" Margin="20">
                    <TextBlock Text="用户名" />
                    <TextBox Margin="0,4,0,10" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="密码" />
                    <PasswordBox
                        Margin="0,4,0,10"
                        ia:PasswordBoxAssist.Attach="True"
                        ia:PasswordBoxAssist.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        MinHeight="20"
                        Foreground="#B23A48"
                        Text="{Binding Message}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="0,10,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="80"
                            Margin="0,0,8,0"
                            Command="{Binding SignInCommand}"
                            Content="登录"
                            IsDefault="True"
                            Style="{StaticResource LabViewButton}" />
                        <Button
                            Width="80"
                            Command="{Binding CancelCommand}"
                            Content="退出"
                            IsCancel="True"
                            Style="{StaticResource LabViewButton}" />
                    </StackPanel>
                </StackPanel>-->

                <StackPanel Grid.Column="0" Margin="20,0,0,10">
                    <Label
                        Margin="0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Content="Login"
                        FontFamily="Segoe UI Black"
                        FontSize="24" />


                    <StackPanel Margin="0,15" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Iconfont}"
                            FontSize="20"
                            Foreground="Black"
                            Opacity="0.5"
                            Text="&#xe610;" />
                        <!--<TextBox x:Name="UserName" Text="{Binding Username, Mode=TwoWay}"  Width="250" Margin="5 0 0 0" Height="30" VerticalContentAlignment="Center"/>-->
                        <ComboBox
                            Width="250"
                            Height="30"
                            Margin="5,0,0,0"
                            VerticalContentAlignment="Center"
                            FontSize="15"
                            ItemsSource="{Binding Usernames, Mode=OneWay}"
                            SelectedValue="{Binding Username, Mode=OneWayToSource}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Iconfont}"
                            FontSize="20"
                            Foreground="Black"
                            Opacity="0.5"
                            Text="&#xe69f;" />
                        <PasswordBox
                            x:Name="Password"
                            Width="250"
                            Height="30"
                            Margin="5,0,0,0"
                            VerticalContentAlignment="Center"
                            ia:PasswordBoxAssist.Attach="True"
                            ia:PasswordBoxAssist.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    </StackPanel>
                    <Grid>
                        <CheckBox
                            Margin="5,10"
                            Content="记住用户名"
                            Foreground="#707070" />
                        <Label
                            Margin="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="忘记密码"
                            Foreground="#707070" />
                    </Grid>
                    <Button
                        Width="100"
                        Height="30"
                        HorizontalAlignment="Center"
                        Command="{Binding SignInCommand}"
                        Content="登录"
                        Cursor="Hand"
                        FontFamily="{StaticResource Iconfont}"
                        FontSize="18"
                        Style="{StaticResource LabViewButton}"
                        Tag="&#xe840;" />
                    <Label
                        MinHeight="20"
                        Margin="2,15,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Content="{Binding Message}"
                        FontSize="15"
                        Foreground="#B23A48" />
                </StackPanel>


            </Border>
        </Grid>
    </Border>
</UserControl>
