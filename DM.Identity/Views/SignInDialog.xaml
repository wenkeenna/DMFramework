<UserControl x:Class="DM.Identity.Views.SignInDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ia="clr-namespace:DM.Identity.Behaviors">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>
    </prism:Dialog.WindowStyle>
    <StackPanel Width="300" Margin="20">
        <TextBlock Text="用户名" />
        <TextBox Margin="0,4,0,10" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="密码" />
        <PasswordBox Margin="0,4,0,10" ia:PasswordBoxAssist.Attach="True"
                     ia:PasswordBoxAssist.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Foreground="#B23A48" TextWrapping="Wrap" MinHeight="20" Text="{Binding Message}" />
        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="80" Margin="0,0,8,0" Content="登录" IsDefault="True" Command="{Binding SignInCommand}" />
            <Button Width="80" Content="退出" IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
