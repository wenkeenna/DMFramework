<UserControl
    x:Class="DM.Identity.Views.SignInDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ia="clr-namespace:DM.Identity.Behaviors"
    xmlns:prism="http://prismlibrary.com/">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DM.UI;component/Themes/Themes.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="ShowInTaskbar" Value="False" />
        </Style>
    </prism:Dialog.WindowStyle>
    <StackPanel Width="300" Margin="20">
        <TextBlock Text="用户名" />
        <TextBox Margin="0,4,0,10" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="密码" />
        <PasswordBox
            Margin="0,4,0,10"
            ia:PasswordBoxAssist.Attach="True"
            ia:PasswordBoxAssist.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
            MinHeight="20"
            Foreground="#B23A48"
            Text="{Binding Message}"
            TextWrapping="Wrap" />
        <StackPanel
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Command="{Binding SignInCommand}"
                Content="登录"
                IsDefault="True"
                Style="{StaticResource LabViewButton}" />
            <Button
                Width="80"
                Command="{Binding CancelCommand}"
                Content="退出"
                IsCancel="True"
                Style="{StaticResource LabViewButton}" />
        </StackPanel>
    </StackPanel>
</UserControl>
